# Primary hackathon provider: NVIDIA Brev + vLLM + Qwen.
THINKLAB_AI_PROVIDER=qwen
THINKLAB_AI_BASE_URL=http://127.0.0.1:8000/v1
THINKLAB_AI_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
THINKLAB_AI_TIMEOUT_MS=20000

# Optional server-side token for an authenticated OpenAI-compatible endpoint.
THINKLAB_AI_TOKEN=

# Optional legacy rollback provider. Only used when THINKLAB_AI_PROVIDER=gemini.
GEMINI_API_KEY=
